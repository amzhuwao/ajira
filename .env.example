# Database — SQLite for local; PostgreSQL for production
DATABASE_URL="file:./dev.db"

# Auth.js
AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Search Console — paste the content= value from the HTML meta tag
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Google AdSense (optional — leave unset until approved)
# Publisher ID for ads.txt: pub-XXXXXXXXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_PUB_ID="pub-XXXXXXXXXXXXXXXX"
# Client ID for script: ca-pub-XXXXXXXXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_CLIENT="ca-pub-XXXXXXXXXXXXXXXX"
# For EEA/UK/CH personalized ads, enable Google Privacy & messaging (certified CMP) in AdSense.

# Paynow (https://developers.paynow.co.zw/docs/paynow/nodejs_quickstart/)
PAYNOW_INTEGRATION_ID=""
PAYNOW_INTEGRATION_KEY=""
PAYNOW_RESULT_URL="http://localhost:3000/api/paynow/result"
PAYNOW_RETURN_URL="http://localhost:3000/dashboard/escrow/return"

# Self-hosted SMTP (optional in local dev — logs instead of sending)
SMTP_HOST="ajira.online"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="info@ajira.online"
SMTP_PASS=""
MAIL_FROM="Ajira <info@ajira.online>"
